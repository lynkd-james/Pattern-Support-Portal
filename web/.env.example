# =============================================================================
# Pattern Support Portal — environment variables (Stage 1)
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# All variables are SERVER-ONLY. None are exposed to the browser.
# =============================================================================

# ---- Database (required for migrate / seed / verify) ------------------------
# Vercel Postgres: use the POOLED connection string (the one with `-pooler`),
# which includes `sslmode=require`. Example shape (not a real credential):
#   postgres://USER:PASSWORD@HOST-pooler.REGION.postgres.vercel-storage.com/DB?sslmode=require
DATABASE_URL=

# ---- ClickUp (used from Stage 2) --------------------------------------------
# ClickUp personal/OAuth token. Sent RAW in the Authorization header (no "Bearer").
CLICKUP_API_TOKEN=

# ClickUp integration scope (REQUIRED — the sync fails fast if either is absent).
CLICKUP_TEAM_ID=               # <your ClickUp Team ID>
CLICKUP_SUPPORT_FOLDER_ID=     # <your Weekly Support Tickets Folder ID>

# Field names + tuning (non-secret; safe defaults if omitted).
# CLICKUP_CUSTOMER_FIELD_NAME=Customer          # custom field -> business unit
# CLICKUP_SLA_PRIORITY_FIELD_NAME=SLA Priority  # custom field -> P1/P2/P3
# CLICKUP_SYNC_OVERLAP_MS=60000                 # re-scan window to avoid misses
# CLICKUP_INCLUDE_ARCHIVED=true                 # include archived lists/tasks (default true; set false to disable backfill)

# ---- Microsoft Graph app-only (used from Stage 6: Outlook acknowledgement) --
# Entra ID app registration with APPLICATION permission Mail.Read (admin-consented),
# ideally restricted to the support mailbox via an application access policy.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Shared mailbox scanned for the "ticket has been logged" acknowledgement email.
# GRAPH_SUPPORT_MAILBOX=supportdesk@lynkd.co.za
# GRAPH_SYNC_OVERLAP_MS=60000                     # re-scan window to avoid misses

# ---- Portal authentication (Stage 8b) ---------------------------------------
# The SET of enabled identity providers (comma list). Values: entra | google |
# placeholder. 'placeholder' is EXCLUSIVE (dev bypass; cannot combine with a
# real provider; refuses production unless ALLOW_PLACEHOLDER_AUTH=true).
# 'google' arrives in Stage 8c. See docs/identity-providers.md + docs/auth.md.
AUTH_ENABLED_PROVIDERS=placeholder
# DEPRECATED (removed in Stage 8d): legacy single-value form, honoured as an
# alias; must agree with AUTH_ENABLED_PROVIDERS if both are set.
# AUTH_PROVIDER=placeholder

# Entra app registration for PORTAL SIGN-IN (multi-tenant, delegated
# openid/profile/email + optional claim xms_edov). This is a SEPARATE app from
# the Graph mail registration above. Required when AUTH_PROVIDER=entra.
AUTH_ENTRA_CLIENT_ID=
AUTH_ENTRA_CLIENT_SECRET=
# Authority: multi-tenant sign-in; the portal DB authorises (tenant pinning).
# AUTH_ENTRA_AUTHORITY=https://login.microsoftonline.com/organizations

# Absolute base URL of the portal (redirect URI base = PORTAL_BASE_URL +
# /api/auth/callback; register it on the app). http://localhost:3000 in dev.
PORTAL_BASE_URL=

# Session lifetimes, enforced server-side on EVERY request (not cookie expiry):
# sliding idle timeout and hard absolute cap, in hours.
# SESSION_IDLE_HOURS=8
# SESSION_MAX_HOURS=720

# Escape hatch: allow the no-auth placeholder provider in production. Leave unset.
# ALLOW_PLACEHOLDER_AUTH=false

# ---- Portal scope (PLACEHOLDER PROVIDER ONLY — dev) --------------------------
# Which account the read API/dashboard is scoped to when
# AUTH_PROVIDER=placeholder. Must match a seeded account slug.
# PORTAL_ACCOUNT_SLUG=pnp

# ---- Publishing (used from Stage 5) -----------------------------------------
# When false (default): transformed tickets park at `ready_for_customer` and are
# NOT projected to the customer layer. When true: tickets meeting the publishing
# criteria are marked `published` during transformation.
AUTO_PUBLISH_ENABLED=false

# ---- Optional connection tuning (sensible defaults if omitted) --------------
# Max connections in the pool (keep small for serverless). Default: 5
# PGPOOL_MAX=5
# Force-disable TLS (use ONLY for a local non-SSL Postgres). Default: auto
# PG_DISABLE_SSL=false
# Override path to the schema file the migration runner applies.
# Default: ../schema.sql (repo root, relative to the web/ working directory)
# SCHEMA_SQL_PATH=../schema.sql
